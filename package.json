{
  "name": "dsh-rules-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Rules settings page in DSH: view, create, and edit the global AGENTS.md and every project's rule files.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "scripts": {
    "test": "node test/host.test.mjs && node test/render.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "manifestVersion": 1
  },
  "files": [
    "README.md",
    "LICENSE",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whereislittlefish-dot/dsh-rules-manager.git"
  },
  "homepage": "https://github.com/whereislittlefish-dot/dsh-rules-manager#readme",
  "license": "MIT"
}
